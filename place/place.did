type TransferFromError = 
 variant {
   BadBurn: record {min_burn_amount: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientAllowance: record {allowance: nat;};
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type TopPainter = 
 record {
   placements: nat;
   player: principal;
 };
type Time = int;
type Stats = 
 record {
   distinctPainters: nat;
   gridSize: nat;
   paletteSize: nat;
   pixelFeeE8s: nat;
   totalAdBurnedE8s: nat;
   totalBurnedPiko: nat;
   totalPlacements: nat;
 };
type ReportAdResult = 
 variant {
   Err: ReportAdError;
   Ok: record {
         reports: nat;
         suspicious: bool;
       };
 };
type ReportAdError = 
 variant {
   AlreadyReported;
   Anonymous;
   InvalidSlot;
   NoActiveAd;
   NotAPainter;
   OwnAd;
 };
type RentAdResult = 
 variant {
   Err: RentAdError;
   Ok: Ad;
 };
type RentAdError = 
 variant {
   Anonymous;
   HeightUnavailable;
   InvalidBlocks;
   InvalidImage;
   InvalidLink;
   InvalidSlot;
   InvalidText;
   PriceAboveMax: record {pricePerBlockE8s: nat;};
   QueueFull;
   SlotBusy;
   TooSoon: record {retryAfterNanos: nat;};
   TransferFailed: TransferFromError;
 };
type RecentPlacement = 
 record {
   color: nat8;
   player: principal;
   timestamp: Time;
   x: nat;
   y: nat;
 };
type PlaceResult = 
 variant {
   Err: PlaceError;
   Ok;
 };
type PlaceError = 
 variant {
   Anonymous;
   InvalidColor;
   OutOfBounds;
   TooSoon: record {retryAfterNanos: nat;};
   TransferFailed: TransferFromError;
 };
type Config = 
 record {
   gridSize: nat;
   paletteSize: nat;
   pikoLedgerId: principal;
   pikoLedgerLocked: bool;
   pixelFeeE8s: nat;
 };
type AdSlot = 
 record {
   current: opt Ad;
   queue: vec Ad;
   reportedByMe: bool;
   slot: nat;
 };
type AdMarket = 
 record {
   currentHeight: nat;
   floorPricePerBlockE8s: nat;
   heightUpdatedAt: Time;
   imageHeight: nat;
   imageWidth: nat;
   lifetimeHoursPerBlock: nat;
   maxBlocks: nat;
   maxLinkChars: nat;
   maxQueue: nat;
   maxTextChars: nat;
   minBlocks: nat;
   minLifetimeDays: nat;
   pricePerBlockE8s: nat;
   slots: vec AdSlot;
   suspiciousAfterReports: nat;
   targetBlockSeconds: nat;
   totalAdBurnedE8s: nat;
   totalAdRentals: nat;
 };
type Ad = 
 record {
   advertiser: principal;
   blocks: nat;
   blocksLeft: nat;
   burnedE8s: nat;
   deadline: opt Time;
   id: nat;
   image: opt blob;
   imageHidden: bool;
   link: opt text;
   reports: nat;
   slot: nat;
   startHeight: opt nat;
   suspicious: bool;
   "text": text;
 };
service : {
  getActiveAds: () -> (vec Ad) query;
  getAdMarket: () -> (AdMarket) query;
  getCanvas: () -> (vec nat8) query;
  getConfig: () -> (Config) query;
  getRecentPlacements: () -> (vec RecentPlacement) query;
  getStats: () -> (Stats) query;
  getTopPainters: (limit: nat) -> (vec TopPainter) query;
  lockMotherId: () -> ();
  lockPikoLedgerId: () -> ();
  placePixel: (x: nat, y: nat, color: nat8) -> (PlaceResult);
  pruneStalePlaceAttempts: () -> (nat);
  rentAdSlot: (slot: nat, "text": text, link: opt text, image: opt blob,
   blocks: nat, maxPricePerBlockE8s: nat) -> (RentAdResult);
  reportAd: (slot: nat) -> (ReportAdResult);
  resetCanvas: () -> ();
  setMotherId: (id: principal) -> ();
  setPikoLedgerId: (id: principal, mintingAccount: principal) -> ();
  topUpPlaceFrontend: () -> (record {sent: nat;});
}
