type TransferFromError = 
 variant {
   BadBurn: record {min_burn_amount: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientAllowance: record {allowance: nat;};
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type TopPainter = 
 record {
   placements: nat;
   player: principal;
 };
type Time = int;
type Stats = 
 record {
   distinctPainters: nat;
   gridSize: nat;
   paletteSize: nat;
   pixelFeeE8s: nat;
   totalBurnedPiko: nat;
   totalPlacements: nat;
 };
type RentAdResult = 
 variant {
   Err: RentAdError;
   Ok: Ad;
 };
type RentAdError = 
 variant {
   Anonymous;
   ExtensionTooLong;
   InvalidDuration;
   InvalidLink;
   InvalidSlot;
   InvalidText;
   PriceAboveMax: record {pricePerDayE8s: nat;};
   SlotBusy;
   SlotTaken: record {expiresAt: Time;};
   TooSoon: record {retryAfterNanos: nat;};
   TransferFailed: TransferFromError;
 };
type RecentPlacement = 
 record {
   color: nat8;
   player: principal;
   timestamp: Time;
   x: nat;
   y: nat;
 };
type PlaceResult = 
 variant {
   Err: PlaceError;
   Ok;
 };
type PlaceError = 
 variant {
   Anonymous;
   InvalidColor;
   OutOfBounds;
   TooSoon: record {retryAfterNanos: nat;};
   TransferFailed: TransferFromError;
 };
type Config = 
 record {
   gridSize: nat;
   paletteSize: nat;
   pikoLedgerId: principal;
   pikoLedgerLocked: bool;
   pixelFeeE8s: nat;
 };
type AdSlot = 
 record {
   ad: opt Ad;
   slot: nat;
 };
type AdMarket = 
 record {
   floorPricePerDayE8s: nat;
   maxDays: nat;
   maxLinkChars: nat;
   maxTextChars: nat;
   pricePerDayE8s: nat;
   slots: vec AdSlot;
   totalAdBurnedE8s: nat;
   totalAdRentals: nat;
 };
type Ad = 
 record {
   advertiser: principal;
   burnedE8s: nat;
   expiresAt: Time;
   link: opt text;
   rentedAt: Time;
   slot: nat;
   "text": text;
 };
service : {
  getActiveAds: () -> (vec Ad) query;
  getAdMarket: () -> (AdMarket) query;
  getCanvas: () -> (vec nat8) query;
  getConfig: () -> (Config) query;
  getRecentPlacements: () -> (vec RecentPlacement) query;
  getStats: () -> (Stats) query;
  getTopPainters: (limit: nat) -> (vec TopPainter) query;
  lockPikoLedgerId: () -> ();
  placePixel: (x: nat, y: nat, color: nat8) -> (PlaceResult);
  pruneStalePlaceAttempts: () -> (nat);
  rentAdSlot: (slot: nat, "text": text, link: opt text, days: nat,
   maxPricePerDayE8s: nat) -> (RentAdResult);
  resetCanvas: () -> ();
  setPikoLedgerId: (id: principal, mintingAccount: principal) -> ();
  topUpPlaceFrontend: () -> (record {sent: nat;});
}
